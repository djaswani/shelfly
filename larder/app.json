{
  "expo": {
    "name": "Larder",
    "slug": "larder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.djaswani.larder"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.djaswani.larder"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Larder uses the camera to scan barcodes and receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Larder reads receipt photos you choose to add your groceries.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withQuotedBundleScript",
      "./plugins/withSceneLifecycle"
    ],
    "scheme": "larder",
    "experiments": {
      "typedRoutes": true
    }
  }
}
