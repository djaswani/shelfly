{
  "expo": {
    "name": "Shelfly",
    "slug": "shelfly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.djaswani.shelfly"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.djaswani.shelfly"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Shelfly uses the camera to scan barcodes and receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Shelfly reads receipt photos you choose to add your groceries.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withQuotedBundleScript",
      "./plugins/withSceneLifecycle",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosShareExtensionName": "Save to Shelfly",
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ]
    ],
    "scheme": "shelfly",
    "experiments": {
      "typedRoutes": true
    }
  }
}
